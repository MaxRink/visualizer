<% content_for :title, "Quick feedback about your subscription" %>
<% content_for :preheader, "Could you share why you canceled?" %>
<tr>
  <td style="padding: 24px; background-color: #ffffff; border-radius: 16px">
    <h1 style="margin: 0 0 24px; color: #171717; font-size: 28px; line-height: 36px">
      A quick favour about your subscription
    </h1>
    <p style="margin: 0 0 24px; color: #525252; font-size: 16px; line-height: 24px">
      Your subscription on <%= Instance.name %> has ended. If you have a minute, I would like to know why you canceled, so the next version is better.
    </p>
    <p style="margin: 0 0 24px; color: #525252; font-size: 16px; line-height: 24px">
      Reply to this email with anything that was missing, confusing or not worth it. A sentence is enough.
    </p>
    <p style="margin: 0; color: #525252; font-size: 16px; line-height: 24px">
      Thanks for having tried it.<br>
      <%= Instance.name %>
    </p>
  </td>
</tr>
