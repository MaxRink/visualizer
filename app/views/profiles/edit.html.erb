<div class="mx-auto flex max-w-7xl flex-col sm:px-6 lg:px-8">
  <div class="flex flex-row justify-between gap-2 px-4 sm:px-0">
    <div>
      <h1 class="truncate py-4 pr-2 font-serif text-3xl font-bold text-neutral-900 lining-nums sm:text-4xl dark:text-neutral-100">
        Edit Your Profile
      </h1>
    </div>
  </div>
  <div class="md:grid md:grid-cols-3 md:gap-6">
    <div class="divide-y divide-neutral-200 px-4 sm:px-6 md:col-span-1 md:p-0 dark:divide-neutral-700">
      <div class="py-6">
        <% if @profile.public %>
          <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">
            Your profile is <strong>PUBLIC</strong>.
          </h3>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            Anyone can see you and all of your shots in <%= link_to "Community", community_index_path, class: "standard-link" %>.
          </p>
        <% else %>
          <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">
            Your profile is <strong>PRIVATE</strong>.
          </h3>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            People can still view any of your shots if you give them a direct link, but you are not visible in <%= link_to "Community", community_index_path, class: "standard-link" %>.
          </p>
        <% end %>
      </div>
      <% if User.web_push_configured? %>
      <div class="py-6" data-controller="push-notifications" data-push-notifications-vapid-key-value="<%= WebPushConfig.public_key&.tr("_-", "/+") %>">
        <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100" data-push-notifications-target="statusHeading">…</h3>
        <div class="flex items-center gap-2">
          <button class="button-white hidden! px-3 py-2" data-action="click->push-notifications#attemptToSubscribe" data-push-notifications-target="bell">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
              <path d="M4.214 3.227a.75.75 0 0 0-1.156-.955 8.97 8.97 0 0 0-1.856 3.825.75.75 0 0 0 1.466.316 7.47 7.47 0 0 1 1.546-3.186ZM16.942 2.272a.75.75 0 0 0-1.157.955 7.47 7.47 0 0 1 1.547 3.186.75.75 0 0 0 1.466-.316 8.971 8.971 0 0 0-1.856-3.825Z" />
              <path fill-rule="evenodd" d="M10 2a6 6 0 0 0-6 6c0 1.887-.454 3.665-1.257 5.234a.75.75 0 0 0 .515 1.076 32.91 32.91 0 0 0 3.256.508 3.5 3.5 0 0 0 6.972 0 32.903 32.903 0 0 0 3.256-.508.75.75 0 0 0 .515-1.076A11.448 11.448 0 0 1 16 8a6 6 0 0 0-6-6Zm0 14.5a2 2 0 0 1-1.95-1.557 33.54 33.54 0 0 0 3.9 0A2 2 0 0 1 10 16.5Z" clip-rule="evenodd" />
            </svg>
          </button>
          <p class="text-sm text-neutral-600 dark:text-neutral-400" data-push-notifications-target="statusDescription"></p>
        </div>
      </div>
      <% end %>
      <div class="py-6">
        <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">Your data</h3>
        <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
          <%= pluralize(@shot_count, "shot") %> using <%= number_to_human_size(@storage_bytes) %> of storage on this instance.
        </p>
      </div>
      <div class="py-6" data-controller="passkeys">
        <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">Passkeys</h3>
        <% if Current.user.webauthn_credentials.any? %>
          <div class="mt-4">
            <div class="space-y-2">
              <% !Current.user.webauthn_credentials.order(:created_at).each do |credential| %>
                <div id="<%= dom_id(credential) %>" class="flex items-center justify-between rounded-md bg-neutral-50 px-3 py-2 dark:bg-neutral-800">
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium text-neutral-900 dark:text-neutral-100">
                      <%= credential.nickname.presence || "Unnamed Passkey" %>
                    </p>
                    <p class="text-xs text-neutral-500 dark:text-neutral-400">
                      Created <%= time_ago_in_words(credential.created_at) %> ago
                      <% if credential.last_used_at %>• Last used <%= time_ago_in_words(credential.last_used_at) %> ago<% end %>
                    </p>
                  </div>
                  <div class="ml-4 shrink-0">
                    <%= link_to "Delete", passkey_path(credential),
                        class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300",
                        data: {turbo_method: :delete,turbo_confirm: "Are you sure you want to delete this passkey? You won't be able to use it to sign in anymore."}
                    %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="mt-4">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              You don't have any passkeys registered yet. Register one to enable passwordless authentication.
            </p>
          </div>
        <% end %>
        <div class="mt-4 flex items-center gap-2">
          <button type="button" class="button-white px-3 py-2" data-passkeys-target="button" data-action="click->passkeys#register">
            Register a passkey
          </button>
        </div>
        <div id="passkey-success" class="hidden">
          <%= render Notification.new(type: :default, heading: "Passkey registered successfully", timeout: 3000) %>
        </div>
        <div id="passkey-already-registered" class="hidden">
          <%= render Notification.new(type: :alert, heading: "Passkey already registered", text: "This passkey is already registered to your account.", timeout: 3000) %>
        </div>
      </div>
      <div class="py-6">
        <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">Upload keys</h3>
        <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
          Password-free credentials for the public API.
          <%= link_to "How to use this key", "https://github.com/MaxRink/visualizer/blob/main/docs/API.md", class: "standard-link", target: "_blank" %>.
        </p>
        <% @upload_keys.each do |upload_key| %>
          <div class="mt-4 rounded-md bg-neutral-50 px-3 py-2 dark:bg-neutral-800" data-controller="upload-key">
            <p class="text-xs text-neutral-500 dark:text-neutral-400">
              <%= upload_key.name %>
              &bull; Created <%= time_ago_in_words(upload_key.created_at) %> ago
              <% if upload_key.last_used_at %>&bull; Last used <%= time_ago_in_words(upload_key.last_used_at) %> ago<% end %>
            </p>
            <div class="mt-2 flex items-center gap-2">
              <code class="min-w-0 flex-1 truncate font-mono text-sm text-neutral-900 dark:text-neutral-100" data-upload-key-target="masked"><%= upload_key.masked_token %></code>
              <code class="hidden min-w-0 flex-1 truncate font-mono text-sm text-neutral-900 dark:text-neutral-100" data-upload-key-target="plain"><%= upload_key.token %></code>
              <button type="button" class="button-white px-3 py-1.5 text-sm" data-action="upload-key#toggle" data-upload-key-target="toggle">Reveal</button>
              <button type="button" class="button-white px-3 py-1.5 text-sm" data-action="upload-key#copy" data-upload-key-target="copy">Copy</button>
              <%= button_to "Revoke", profile_upload_key_path(upload_key), method: :delete, class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300", form: {data: {turbo_confirm: "Revoke #{upload_key.name}? Clients using it stop working immediately."}} %>
            </div>
          </div>
        <% end %>
        <% if @upload_keys.none? %>
          <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">You don't have an upload key yet.</p>
        <% end %>
        <%= form_with url: profile_upload_keys_path, class: "mt-4 flex items-center gap-2" do |f| %>
          <%= f.text_field :name, placeholder: "Key name (e.g. Beanconqueror)", class: "standard-input" %>
          <%= f.submit "Create upload key", class: "button-white px-3 py-2 text-sm" %>
        <% end %>
      </div>
      <% if oidc_configured? %>
        <% oidc_identity = Current.user.oidc_identity %>
        <div class="py-6">
          <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">OpenID Connect</h3>
          <% if oidc_identity %>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
              <%= oidc_identity.provider_label %> is linked to this account.
            </p>
            <div class="mt-4 rounded-md bg-neutral-50 px-3 py-2 dark:bg-neutral-800">
              <p class="text-xs text-neutral-500 dark:text-neutral-400">
                <%= oidc_identity.email.presence || Current.user.email %>
                &bull; Linked <%= time_ago_in_words(oidc_identity.created_at) %> ago
              </p>
            </div>
            <div class="mt-3">
              <%= button_to "Unlink", disconnect_oidc_profile_path, method: :delete, class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300", form: {data: {turbo_confirm: "Unlink #{oidc_identity.provider_label}? Make sure you can still sign in another way."}} %>
            </div>
          <% else %>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
              Connect your OpenID Connect account to sign in without a password.
            </p>
            <div class="mt-3">
              <%= button_to "Link OpenID Connect", sign_in_with_homelab_oidc_path, class: "button-white px-3 py-2 text-sm", form: {data: {turbo: false}} %>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="py-6">
        <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">Mirror to upstream</h3>
        <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
          Send every new shot to another Visualizer instance with your own token. This is off by default and only ever sends this account's shots; no upload keys or other users' data leave this instance. A failed push never blocks the local shot.
        </p>
        <% if @profile.upstream_api_token.present? %>
          <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">Token configured. It is never shown again; replace it below or clear it.</p>
        <% end %>
        <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400">
          Last checked: <%= @profile.upstream_push_checked_at ? time_ago_in_words(@profile.upstream_push_checked_at) + " ago" : "never" %>.
          Last push: <%= @upstream_last_push ? time_ago_in_words(@upstream_last_push) + " ago" : "never" %>.
          <% if @upstream_last_error.present? %><span class="text-red-600 dark:text-red-400">Last error: <%= @upstream_last_error %></span><% end %>
        </p>
        <%= form_with(model: @profile, url: profile_path, class: "mt-4 space-y-3") do |f| %>
          <label class="flex items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300">
            <%= f.check_box :upstream_push_enabled, class: "standard-checkbox size-4 cursor-pointer" %>
            Enable mirroring
          </label>
          <div>
            <%= f.label :upstream_base_url, "Upstream base URL", class: "standard-label" %>
            <%= f.url_field :upstream_base_url, class: "mt-1 standard-input", placeholder: "https://visualizer.coffee" %>
          </div>
          <div>
            <%= f.label :upstream_api_token, "Upstream token (write-only)", class: "standard-label" %>
            <%= f.password_field :upstream_api_token, class: "mt-1 standard-input", autocomplete: "off", placeholder: "Leave blank to keep the current token" %>
          </div>
          <%= f.submit "Save mirroring settings", class: "button-white px-3 py-2 text-sm" %>
        <% end %>
        <div class="mt-3 flex items-center gap-2">
          <%= button_to "Send test", test_upstream_push_profile_path, class: "button-white px-3 py-2 text-sm" %>
          <% if @profile.upstream_api_token.present? %>
            <%= button_to "Clear token", clear_upstream_token_profile_path, method: :delete, class: "text-sm text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300", form: {data: {turbo_confirm: "Clear the upstream token and disable mirroring?"}} %>
          <% end %>
        </div>
      </div>
      <% if Current.user.has_airtable? %>
        <div class="py-6">
          <%= render "shared/modal" %>
          <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">
            You are connected to Airtable.
          </h3>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            If you want to disconnect or reset your Airtable connection, you can <%= link_to "do so here", disconnect_airtable_profile_path, class: "standard-link",  data: {turbo_method: :delete, action: "click->modal#confirm", title: "Disconnect Airtable", text: "Are you sure you want to disconnect your Airtable account? Your data will NOT be deleted from Airtable or Visualizer. You will be able to reconnect at any time to resume syncing."} %>.
          </p>
        </div>
      <% end %>
      <% if @authorized_applications.any? %>
        <div class="py-6">
          <h3 class="text-lg leading-6 font-medium text-neutral-900 dark:text-neutral-100">
            You have <strong><%= pluralize(@authorized_applications.size, "application") %></strong> authorized via OAuth.
          </h3>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            You can <%= link_to "manage #{@authorized_applications.size == 1 ? "it" : "them"} here", oauth_authorized_applications_path, class: "standard-link", data: {turbo: false} %>.
          </p>
        </div>
      <% end %>
    </div>
    <hr class="mx-4 text-neutral-200 sm:mx-6 md:hidden dark:text-neutral-700">
    <%= render "form", profile: @profile %>
    <div id="passkey-error" class="hidden">
      <%= render Notification.new(type: :alert, heading: "Error creating passkey", text: "Something went wrong", timeout: 3000) %>
    </div>
  </div>
</div>
