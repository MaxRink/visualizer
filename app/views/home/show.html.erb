<div class="mx-auto max-w-2xl px-6 py-16 text-center sm:py-24">
  <h1 class="font-serif text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl dark:text-neutral-100">
    A private coffee log
  </h1>
  <p class="mt-6 text-lg leading-8 text-neutral-600 dark:text-neutral-300">
    This is a self-hosted Visualizer instance: shots, coffee bags and charts for a small group of people, running on hardware its owner controls.
  </p>
  <p class="mt-4 text-base leading-7 text-neutral-600 dark:text-neutral-300">
    There is no public sign-up. Accounts come from the instance's OpenID Connect provider; ask whoever runs it if you need access.
  </p>
  <div class="mt-10 flex items-center justify-center">
    <%= link_to "Sign in", new_session_path, class: "button-terracotta px-4 py-2.5" %>
  </div>
</div>
