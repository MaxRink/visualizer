<div class="p-4 text-neutral-500 shadow dark:bg-neutral-950 dark:text-neutral-400 <%= 'hidden sm:block' if content_for?(:contained_layout) %>">
  <div class="mx-auto max-w-7xl sm:px-10 lg:px-12">
    <div>
      <div class="flex justify-center whitespace-nowrap sm:justify-between lg:hidden">
        <span>
          © <%= Date.today.year %> <%= Instance.name %>
          </span>
        <a class="standard-link hidden whitespace-nowrap hover:text-neutral-700 sm:inline dark:hover:text-neutral-300" href="/privacy">Privacy Policy</a>
      </div>
      <div class="hidden justify-between whitespace-nowrap lg:flex">
        <span>
          © <%= Date.today.year %> <%= Instance.name %>
        </span>
        <span class="flex items-center gap-4">
          <button type="button" class="standard-link cursor-pointer whitespace-nowrap hover:text-neutral-700 dark:hover:text-neutral-300" data-controller="theme" data-theme-signed-in-value="<%= Current.user.present? %>" data-action="click->theme#toggle">Toggle theme</button>
          <a class="standard-link whitespace-nowrap hover:text-neutral-700 dark:hover:text-neutral-300" href="/privacy">Privacy Policy</a>
        </span>
      </div>
    </div>
  </div>
</div>
