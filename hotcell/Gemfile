# The cell's Gemfile. Keep it short: every gem loaded here is inside the blast radius and paid for on
# every request. hotcell-client and rails do not belong here.

source "https://rubygems.org"

# Keep this at the application's hotcell-client version; HotCell.describe_cells warns at boot otherwise.
gem "hotcell-server", "1.0.0"

gem "activestorage-hotcell-server", "1.0.0"

# hotcell-core requires "json"; without a bundled copy Ruby's default json gem loads (4.0.7 ships
# 2.18.0, CVE-2026-33210, fixed in 2.19.2).
gem "json", ">= 2.19.2"
